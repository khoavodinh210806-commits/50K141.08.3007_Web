{
  "name": "trinh-ca-phe-inventory-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend quản lý kho Trình Cà Phê dùng PostgreSQL/Supabase",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node build/server.js",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:screen-spec:check": "node scripts/replace-screen-spec-data.mjs --dry-run",
    "db:screen-spec:apply": "node scripts/replace-screen-spec-data.mjs --apply",
    "smoke": "node --env-file=.env scripts/smoke.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
