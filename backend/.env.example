PORT=4000
CORS_ORIGIN=http://localhost:5173
# Copy Session pooler URI from Supabase Dashboard > Connect, then replace [YOUR-PASSWORD]
# Keep this value only on the backend; URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&uselibpqcompat=true
JWT_SECRET=replace-with-a-long-random-secret
# Only needed for local demo seed
SEED_PASSWORD=replace-with-a-demo-password
